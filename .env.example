# Copy the lines you need into your environment (export ...) or your process manager.
# Command-line flags override these.  All values here are fake.
PUMPFUN_STREAM_WS_URL=wss://rpc.example.invalid
PUMPFUN_STREAM_HTTP_URL=https://rpc.example.invalid
PUMPFUN_STREAM_PROGRAMS=pump,pump_amm
PUMPFUN_STREAM_OUT=events.jsonl
PUMPFUN_STREAM_SQLITE=
PUMPFUN_STREAM_COMMITMENT=confirmed
# getTransaction requests per second (0 = no limit)
PUMPFUN_STREAM_RPS=5
PUMPFUN_STREAM_FETCH_WORKERS=4
PUMPFUN_STREAM_QUEUE_SIZE=10000
PUMPFUN_STREAM_FETCH_QUEUE_SIZE=1000
PUMPFUN_STREAM_IDLE_TIMEOUT=120
PUMPFUN_STREAM_DEDUP_SIZE=200000
PUMPFUN_STREAM_STATUS_INTERVAL=10
